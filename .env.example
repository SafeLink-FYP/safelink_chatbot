# SafeLink Safety Chatbot — Environment Configuration
# Copy this file to .env locally; on Railway set these as project variables.

# ───── Server ─────────────────────────────────────────────────────────────────
APP_NAME=SafeLink Safety Chatbot
APP_VERSION=2.0.0
# DEBUG=true: relaxes API-key auth (any/missing key accepted) and enables
# uvicorn reload. Never deploy production with DEBUG=true.
DEBUG=false
HOST=0.0.0.0
# Railway injects $PORT automatically — do NOT hard-code this on Railway.
PORT=8000

# API base path
API_PREFIX=/api/v1

# ───── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
#   Empty (default) → dev fallback ["http://localhost", "http://10.0.2.2"]
#   "*"             → wildcard, but allow_credentials is forced False (CORS spec)
# Production:
#   CORS_ORIGINS=https://safelink.example.com,https://staging.safelink.example.com
CORS_ORIGINS=

# ───── Auth ───────────────────────────────────────────────────────────────────
# Required when DEBUG=false. The Flutter client sends X-API-Key: <this value>
# (configure via --dart-define=CHATBOT_API_KEY=... at build time).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHATBOT_API_KEY=

# ───── Rate Limiting (per-IP, enforced via slowapi) ───────────────────────────
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_FEEDBACK_PER_MIN=5

# ───── Feedback log ───────────────────────────────────────────────────────────
# Empty → defaults to chatbot_backend/data/feedback.jsonl (file-system, ephemeral
# on Railway free tier). Point at a mounted volume in production.
FEEDBACK_LOG_PATH=

# ───── NLP ────────────────────────────────────────────────────────────────────
# Keyword + TF-IDF retrieval is the default and what's bundled in requirements.txt.
USE_EMBEDDINGS=false
USE_SPACY=false
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

INTENT_CONFIDENCE_THRESHOLD=0.55
# 0.15 matches the runtime default (do not raise without retesting retrieval).
RETRIEVAL_SCORE_THRESHOLD=0.15
TOP_K_RESULTS=3

# Path where the trained intent classifier is persisted between cold starts.
# On Railway, /tmp survives within a deploy; for permanent caching mount a volume.
MODEL_CACHE_DIR=/tmp/safelink_chatbot

# ───── Emergency Keywords ─────────────────────────────────────────────────────
# Comma-separated. Trigger the emergency fast-path when (urgency_score >= 0.6
# AND >= 1 keyword overlap). Bare "help" / "emergency" intentionally absent —
# they over-fired on benign queries (e.g. "help me with first aid").
EMERGENCY_KEYWORDS=trapped,dying,drowning,bleeding,unconscious,earthquake now,flood now,fire now,gas leak,collapsed,heart attack,suicide

# ───── Privacy & Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
ANONYMIZE_LOGS=true
LOG_RETENTION_DAYS=30

# ───── Region ─────────────────────────────────────────────────────────────────
DEFAULT_REGION=pakistan

# ───── Optional Database / Redis (currently unused) ───────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/safelink_chatbot
# REDIS_URL=redis://host:6379/0

# ───── Phase 3: Hybrid LLM ────────────────────────────────────────────────────
# USE_LLM=false runs the legacy pipeline unchanged (regression safety).
# USE_LLM=true activates the 5-layer hybrid flow:
#   Layer 1 emergency fast-path (deterministic, NO LLM)
#   Layer 2 intent routing (rules + LR classifier)
#   Layer 3 RAG retrieval (KB v2)
#   Layer 4 LLM generation (Gemini primary, Groq failover)
#   Layer 5 output validator (strip invented numbers, enforce disclaimers)
USE_LLM=false
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_SECONDS=12
LLM_FALLBACK_TIMEOUT_SECONDS=8
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
# Hard cap on tool-call rounds per request (prevents infinite loops).
LLM_MAX_TOOL_ROUNDS=3

# ───── Phase 3: Sessions (in-memory ephemeral) ────────────────────────────────
SESSION_TTL_MINUTES=30
SESSION_MAX_TURNS=6
# Default 1000 fits Railway Hobby tier (~512 MB RAM). Each session at peak
# holds 12 messages × ~500-char content ≈ 8 KB. Raise to 5000 on Pro tier.
SESSION_MAX_ACTIVE=1000
SESSION_SWEEP_INTERVAL_SECONDS=300

# ───── Phase 3: Output validator ──────────────────────────────────────────────
# Markdown link `[text](url)` URLs must use one of these hosts, else stripped.
ALLOWED_LINK_DOMAINS=ndma.gov.pk,pmd.gov.pk,who.int,prcs.org.pk,redcrescent.pk,edhi.org,rescue.gov.pk,heart.org,redcross.org,rozan.org,umang.com.pk,taskeen.org,ssgc.com.pk,sngpl.com.pk,gsp.gov.pk,usgs.gov
OUTPUT_MAX_CHARS=1500

# ───── Phase 3: Offline bundle cache ──────────────────────────────────────────
OFFLINE_BUNDLE_TTL_SECONDS=3600
